    {
      "conflict_id": "CONF_001",
      "country_code": "BAN",
      "topic": "2026 ICC Men's T20 World Cup Participation (Bangladesh vs Scotland Replacement)",
      "description": "Bangladesh originally qualified for the 2026 ICC Men's T20 World Cup, and Litton Das was named T20I captain in May 2025. However, following BCB's refusal to travel to India for Group C fixtures in Kolkata and Mumbai, the ICC replaced Bangladesh with Scotland on 24 January 2026. Both Bangladesh's active 2025–2026 bilateral T20I squad and Scotland's replacement T20 World Cup 2026 squad are preserved in the dataset.",
      "sources": [
        "https://en.wikipedia.org/wiki/2026_Men%27s_T20_World_Cup_squads",
        "https://www.icc-cricket.com/news/scotland-name-squad-for-icc-men-s-t20-world-cup-2026"
      ]
    },
    {
      "conflict_id": "CONF_002",
      "country_code": "SL",
      "topic": "Late-2026 Sri Lanka Captaincy Transition (Dhananjaya de Silva / Charith Asalanka / Dasun Shanaka vs Kusal Mendis)",
      "description": "Sri Lanka Cricket rotated captaincy across 2025–2026: Dhananjaya de Silva led Tests through August 2026, Charith Asalanka led ODIs through September 2026, and Dasun Shanaka replaced Asalanka as T20I captain on 19 December 2025 for the 2026 T20 World Cup, before Kusal Mendis was named captain across the October 2026 Pakistan tour and ODI Tri-Series. All four leaders are documented in format_captains.json.",
      "sources": [
        "https://en.wikipedia.org/wiki/Kusal_Mendis",
        "https://en.wikipedia.org/wiki/2026%E2%80%9327_Pakistan_ODI_Tri-Series"
      ]
    },
    {
      "conflict_id": "CONF_003",
      "country_code": "BAN",
      "topic": "Shakib Al Hasan International Selection Status (2025–2026)",
      "description": "Shakib Al Hasan retired from T20Is in June 2024 and intended to play a farewell home Test in October 2024, but did not appear in any international match in 2025–2026 due to political/security absence despite never issuing a formal ODI retirement letter to the BCB. He is categorized as Inactive/Unavailable rather than currently selectable.",
      "sources": [
        "https://en.wikipedia.org/wiki/Shakib_Al_Hasan"
      ]
    },
    {
      "conflict_id": "CONF_004",
      "country_code": "ZIM",
      "topic": "Zimbabwe Test & ODI Captaincy Rotation (Craig Ervine, Sikandar Raza, Richard Ngarava)",
      "description": "Craig Ervine served as Zimbabwe's appointed Test and ODI captain into 2025, but missed multiple fixtures where Sikandar Raza and Richard Ngarava (who captained Zimbabwe's innings Test victory over Bangladesh in June 2026) led the side. All three captains are cross-referenced across Test and ODI records.",
      "sources": [
        "https://www.cricketworld.com/zim-v-ban-test-day-3-muzarabani-and-ngarava-star-as-zimbabwe-wrap-up-comprehensive-test-victory/111596.htm",
